# ============================================================
#  ALIMUN — Environment Variables
#  Copy this file to .env and fill in your real values.
#  Never commit .env to version control.
#  Every variable here must ALSO be set in Vercel → Project →
#  Settings → Environment Variables (Production) for the site to work.
# ============================================================

# ── APP ─────────────────────────────────────────────────────
APP_URL=https://alimun.com
ADMIN_EMAIL=admin@alimun.com
# Long random string. Signs teacher approve/reject links and authorises
# manual cron/waitlist triggers. Also paste it into
#   update app_settings set value='<ADMIN_SECRET>' where key='admin_secret';
ADMIN_SECRET=change_me_64_random_chars
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to cron
# endpoints. REQUIRED — the crons refuse every request when it is unset.
CRON_SECRET=change_me_64_random_chars

# ── SUPABASE ─────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# ── STRIPE ───────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys. The same variable names
# drive test and live mode; nothing is hardcoded in the HTML
# (see /api/stripe?action=config). To flip modes, swap ALL values below.
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY
# Stripe Dashboard → Developers → Webhooks → endpoint https://alimun.com/api/webhooks/stripe
# Subscribe to: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed,
# charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# Price IDs — EUR subscriptions
STRIPE_PRICE_COMMUNITY_MONTHLY=price_...
STRIPE_PRICE_FOCUSED_MONTHLY=price_...
STRIPE_PRICE_INTENSIVE_MONTHLY=price_...
STRIPE_PRICE_PRIVATE_MONTHLY=price_...
STRIPE_PRICE_COMMUNITY_YEARLY=price_...
STRIPE_PRICE_FOCUSED_YEARLY=price_...
STRIPE_PRICE_INTENSIVE_YEARLY=price_...
STRIPE_PRICE_PRIVATE_YEARLY=price_...

# Price IDs — one-time payments
STRIPE_PRICE_ONEONONE_SESSION=price_...
STRIPE_PRICE_CERTIFICATE=price_...

# Price IDs — regional monthly variants (optional)
STRIPE_PRICE_COMMUNITY_MONTHLY_AUD=
STRIPE_PRICE_FOCUSED_MONTHLY_AUD=
STRIPE_PRICE_INTENSIVE_MONTHLY_AUD=
STRIPE_PRICE_PRIVATE_MONTHLY_AUD=
STRIPE_PRICE_COMMUNITY_MONTHLY_MAD=
STRIPE_PRICE_FOCUSED_MONTHLY_MAD=
STRIPE_PRICE_INTENSIVE_MONTHLY_MAD=
STRIPE_PRICE_PRIVATE_MONTHLY_MAD=

# ── DAILY.CO (live classrooms) ───────────────────────────────
# Daily Dashboard → Developers → API keys
DAILY_API_KEY=YOUR_DAILY_API_KEY

# ── AI (set at least one; priority Gemini > Groq > Anthropic) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Spend controls enforced by /api/ai (see ai_usage table)
AI_DAILY_CALL_CAP=150
AI_DAILY_BUDGET_USD=25

# ── RESEND (transactional email) ─────────────────────────────
# Resend Dashboard → API Keys. Verify the alimun.com domain first, or
# every email to a customer is rejected.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM_ADDRESS=Alimun <no-reply@alimun.com>

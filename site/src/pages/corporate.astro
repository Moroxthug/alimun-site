---
// Corporate page, rebuilt one element at a time from its own blocks.
import Base from '../layouts/Base.astro';
import head from '../blocks/corporate/head.html?raw';
import after from '../blocks/corporate/after.html?raw';
import nav from '../blocks/corporate/nav.html?raw';
import hero from '../blocks/corporate/s01.html?raw';
import why from '../blocks/corporate/s02.html?raw';
import contact from '../blocks/corporate/s02c-contact.html?raw';
import bottomCta from '../blocks/corporate/s06-slider.html?raw';
import footer from '../blocks/corporate/footer.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3eab" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={why} />
    <Fragment set:html={contact} />
    <Fragment set:html={bottomCta} />
  </main>
  <Fragment set:html={footer} />
</Base>

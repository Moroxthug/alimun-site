---
// 31 Oct 2026 (owner: "sure go on then", from the /preview/*-alive pages): the homepage style via blocks/alive.html.
// Tiers page, rebuilt one element at a time from its own verbatim blocks.
import Base from '../layouts/Base.astro';
import head from '../blocks/tiers/head.html?raw';
import after from '../blocks/tiers/after.html?raw';
import nav from '../blocks/tiers/nav.html?raw';
import hero from '../blocks/tiers/hero.html?raw';
import plans from '../blocks/tiers/plans.html?raw';
import perclass from '../blocks/tiers/perclass.html?raw';
import faq from '../blocks/tiers/faq.html?raw';
import bottomCta from '../blocks/home/banner.html?raw';
import footer from '../blocks/footer.html?raw';
import alive from '../blocks/alive.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3ea9" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={plans} />
    <Fragment set:html={perclass} />
    <Fragment set:html={faq} />
    <Fragment set:html={bottomCta} />
  </main>
  <Fragment set:html={footer} />
  <Fragment set:html={alive} />
</Base>

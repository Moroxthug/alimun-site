---
// Homepage, rebuilt one element at a time. Only approved elements are added.
import Base from '../layouts/Base.astro';
import head from '../blocks/head.html?raw';
import after from '../blocks/after-body.html?raw';
import nav from '../blocks/01-nav.html?raw';
import hero from '../blocks/02-hero.html?raw';
import groups from '../blocks/home/groups.html?raw';
import languages from '../blocks/home/languages.html?raw';
import learn from '../blocks/home/learn.html?raw';
import faq from '../blocks/home/faq.html?raw';
import bottomCta from '../blocks/home/banner.html?raw';
import quiz from '../blocks/home/quiz.html?raw';
import footer from '../blocks/07-footer.html?raw';
---
<Base wfPage="68d948d13b6c9f2bbbac3ea7" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={groups} />
    <Fragment set:html={languages} />
    <Fragment set:html={learn} />
    <Fragment set:html={faq} />
    <Fragment set:html={bottomCta} />
  </main>
  <Fragment set:html={quiz} />
  <Fragment set:html={footer} />
</Base>

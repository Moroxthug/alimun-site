---
// Homepage, rebuilt one element at a time. Only approved elements are added.
import Base from '../layouts/Base.astro';
import nav from '../blocks/01-nav.html?raw';
import hero from '../blocks/02-hero.html?raw';
import services from '../blocks/03-services.html?raw';
import cards from '../blocks/04-cards.html?raw';
import faq from '../blocks/05-faq.html?raw';
import bottomCta from '../blocks/06-bottom-cta.html?raw';
import footer from '../blocks/07-footer.html?raw';
---
<Base wfPage="68d948d13b6c9f2bbbac3ea7">
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={services} />
    <Fragment set:html={cards} />
    <Fragment set:html={faq} />
    <Fragment set:html={bottomCta} />
  </main>
  <Fragment set:html={footer} />
</Base>

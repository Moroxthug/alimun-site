---
// About us page, rebuilt one element at a time from its own verbatim blocks.
import Base from '../layouts/Base.astro';
import head from '../blocks/about/head.html?raw';
import after from '../blocks/about/after.html?raw';
import nav from '../blocks/about/nav.html?raw';
import hero from '../blocks/about/s01.html?raw';
import why from '../blocks/about/s02.html?raw';
import paths from '../blocks/about/s02b-paths.html?raw';
import faq from '../blocks/about/faq.html?raw';
import bottomCta from '../blocks/home/banner.html?raw';
import footer from '../blocks/footer.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3eab" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={why} />
    <Fragment set:html={paths} />
    <Fragment set:html={faq} />
    <Fragment set:html={bottomCta} />
  </main>
  <Fragment set:html={footer} />
</Base>

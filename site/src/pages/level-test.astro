---
// Level test page (docs/LEVEL_TEST.md): the start of sign-up for learners. Shared nav and footer.
import Base from '../layouts/Base.astro';
import head from '../blocks/level/head.html?raw';
import after from '../blocks/legal/after.html?raw';
import nav from '../blocks/legal/nav.html?raw';
import test from '../blocks/level/test.html?raw';
import footer from '../blocks/footer.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3ea9" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={test} />
  </main>
  <Fragment set:html={footer} />
</Base>

---
// Careers page, rebuilt one element at a time from its own blocks.
import Base from '../layouts/Base.astro';
import head from '../blocks/careers/head.html?raw';
import after from '../blocks/careers/after.html?raw';
import nav from '../blocks/careers/nav.html?raw';
import hero from '../blocks/careers/s01.html?raw';
import why from '../blocks/careers/s02.html?raw';
import join from '../blocks/careers/s03.html?raw';
import faq from '../blocks/careers/faq.html?raw';
import banner from '../blocks/careers/s04.html?raw';
import footer from '../blocks/footer.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3eab" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={why} />
    <Fragment set:html={join} />
    <Fragment set:html={faq} />
    <Fragment set:html={banner} />
  </main>
  <Fragment set:html={footer} />
</Base>

---
// Careers page, rebuilt one element at a time from its own blocks.
import Base from '../layouts/Base.astro';
import head from '../blocks/careers/head.html?raw';
import after from '../blocks/careers/after.html?raw';
import nav from '../blocks/careers/nav.html?raw';
import hero from '../blocks/careers/s01.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3eab" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
  </main>
</Base>

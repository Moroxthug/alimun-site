---
// Not found page: shared nav and footer. Its head sets <base href="/"> so the
// relative asset links work at any missing path.
import Base from '../layouts/Base.astro';
import head from '../blocks/legal/head-404.html?raw';
import after from '../blocks/legal/after.html?raw';
import nav from '../blocks/legal/nav.html?raw';
import body from '../blocks/legal/404.html?raw';
import footer from '../blocks/footer.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3ea9" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={body} />
  </main>
  <Fragment set:html={footer} />
</Base>

---
// Services page, rebuilt one element at a time from its own verbatim blocks.
import Base from '../layouts/Base.astro';
import head from '../blocks/services/head.html?raw';
import after from '../blocks/services/after.html?raw';
import nav from '../blocks/services/nav.html?raw';
import hero from '../blocks/services/s01.html?raw';
import tools from '../blocks/services/tools.html?raw';
import tiers from '../blocks/services/s04.html?raw';
import bottomCta from '../blocks/home/banner.html?raw';
import footer from '../blocks/footer.html?raw';
---
<Base wfPage="68d948d23b6c9f2bbbac3eaa" head={head} after={after}>
  <Fragment set:html={nav} />
  <main class="main-wrapper">
    <Fragment set:html={hero} />
    <Fragment set:html={tools} />
    <Fragment set:html={tiers} />
    <Fragment set:html={bottomCta} />
  </main>
  <Fragment set:html={footer} />
</Base>

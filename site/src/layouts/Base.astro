---
// Page frame copied from the homepage export: <head>, the page wrapper and
// the scripts at the end of <body> (jQuery, webflow.js animations, cookies).
import head from '../blocks/head.html?raw';
import afterBody from '../blocks/after-body.html?raw';

interface Props { wfPage: string; lang?: string }
const { wfPage, lang = 'en' } = Astro.props;
---
<!DOCTYPE html>
<html data-wf-page={wfPage} data-wf-site="68d948d03b6c9f2bbbac3e5b" lang={lang}>
<head set:html={head} />
<body>
  <div class="page-wrapper">
    <slot />
  </div>
  <Fragment set:html={afterBody} />
</body>
</html>

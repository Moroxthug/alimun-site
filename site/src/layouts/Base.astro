---
// Page frame copied from the Webflow export: <head>, the page wrapper and the
// closing scripts (jQuery, webflow.js animations, cookies). Each page passes
// its own verbatim head and closing blocks.
interface Props { wfPage: string; head: string; after: string; lang?: string }
const { wfPage, head, after, lang = 'en' } = Astro.props;
---
<!DOCTYPE html>
<html data-wf-page={wfPage} data-wf-site="68d948d03b6c9f2bbbac3e5b" lang={lang}>
<head set:html={head} />
<body>
  <div class="page-wrapper">
    <slot />
  </div>
  <Fragment set:html={after} />
</body>
</html>

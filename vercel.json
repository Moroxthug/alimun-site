{
  "version": 2,
  "outputDirectory": ".",
  "buildCommand": "npm run build:site",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self \"https://*.daily.co\"), microphone=(self \"https://*.daily.co\"), display-capture=(self \"https://*.daily.co\"), geolocation=(), payment=(self \"https://js.stripe.com\" \"https://checkout.stripe.com\")",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://ajax.googleapis.com https://d3e54v103j8qbb.cloudfront.net https://js.stripe.com https://*.daily.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' data: https://fonts.gstatic.com https://api.fontshare.com https://cdn.fontshare.com; img-src 'self' data: blob: https://dgaiasmefcbrtzqwdyri.supabase.co https://www.launchory.app; media-src 'self' blob: https://dgaiasmefcbrtzqwdyri.supabase.co; connect-src 'self' https://dgaiasmefcbrtzqwdyri.supabase.co wss://dgaiasmefcbrtzqwdyri.supabase.co https://api.stripe.com https://*.daily.co wss://*.daily.co https://*.pluot.blue wss://*.pluot.blue; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://*.daily.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'self'"
      },
      "continue": true
    },
    {
      "src": "/((ar|de|es|fr|it|ma|pt|zh)/)?(admin|signin|signup|signup-success|student-dashboard|teacher-dashboard|forgot-password|reset-password|careers-teachers-section)(\\.html)?",
      "headers": { "X-Robots-Tag": "noindex, nofollow" },
      "continue": true
    },
    {
      "src": "/(site|supabase|\\.agents|\\.github|\\.semgrep|scripts|docs|mockups|node_modules|sandbox)(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(build|verify)\\.js",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)\\.(md|sql|zip|lock)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(package(-lock)?\\.json|vercel\\.json|verification-results\\.json|\\.env.*|\\.gitignore|\\.vercelignore|\\.gitleaks\\.toml)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/api/grade",
      "dest": "/api/ai?action=grade"
    },
    {
      "src": "/api/generate-exercises",
      "dest": "/api/ai?action=generate-exercises"
    },
    {
      "src": "/api/ai-usage",
      "dest": "/api/ai?action=usage"
    },
    {
      "src": "/api/admin/approve-teacher",
      "dest": "/api/admin/teacher?action=approve"
    },
    {
      "src": "/api/admin/reject-teacher",
      "dest": "/api/admin/teacher?action=reject"
    },
    {
      "src": "/api/admin/notify-teacher-application",
      "dest": "/api/admin/teacher?action=notify"
    },
    {
      "src": "/api/create-checkout-session",
      "dest": "/api/stripe?action=create-checkout"
    },
    {
      "src": "/api/checkout-session",
      "dest": "/api/stripe?action=retrieve-session"
    },
    {
      "src": "/api/stripe/create-checkout",
      "dest": "/api/stripe?action=create-checkout"
    },
    {
      "src": "/api/stripe/billing-portal",
      "dest": "/api/stripe?action=billing-portal"
    },
    {
      "src": "/api/stripe/config",
      "dest": "/api/stripe?action=config"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/((?:ar|de|es|fr|it|ma|pt|zh)/)?careers-teachers-section(\\.html)?",
      "headers": { "Location": "/$1careers" },
      "status": 308
    },
    {
      "src": "/locations(.html)?",
      "headers": { "Location": "/tiers" },
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "api/generate-notes-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "fonts/coolvetica-condensed-rg.otf"
    },
    "api/admin/teacher.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-create-rooms",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/waitlist/cron-expire-offers",
      "schedule": "30 0 * * *"
    }
  ]
}

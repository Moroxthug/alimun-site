{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self \"https://*.daily.co\"), microphone=(self \"https://*.daily.co\"), display-capture=(self \"https://*.daily.co\"), geolocation=(), payment=(self \"https://js.stripe.com\" \"https://checkout.stripe.com\")",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      },
      "continue": true
    },
    {
      "src": "/(supabase|\\.agents|mockups|node_modules|sandbox)(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(build|verify)\\.js",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)\\.(md|sql|zip|lock)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(package(-lock)?\\.json|vercel\\.json|verification-results\\.json|\\.env.*|\\.gitignore|\\.vercelignore)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/api/grade",
      "dest": "/api/ai?action=grade"
    },
    {
      "src": "/api/generate-exercises",
      "dest": "/api/ai?action=generate-exercises"
    },
    {
      "src": "/api/ai-usage",
      "dest": "/api/ai?action=usage"
    },
    {
      "src": "/api/admin/approve-teacher",
      "dest": "/api/admin/teacher?action=approve"
    },
    {
      "src": "/api/admin/reject-teacher",
      "dest": "/api/admin/teacher?action=reject"
    },
    {
      "src": "/api/admin/notify-teacher-application",
      "dest": "/api/admin/teacher?action=notify"
    },
    {
      "src": "/api/create-checkout-session",
      "dest": "/api/stripe?action=create-checkout"
    },
    {
      "src": "/api/checkout-session",
      "dest": "/api/stripe?action=retrieve-session"
    },
    {
      "src": "/api/stripe/create-checkout",
      "dest": "/api/stripe?action=create-checkout"
    },
    {
      "src": "/api/stripe/billing-portal",
      "dest": "/api/stripe?action=billing-portal"
    },
    {
      "src": "/api/stripe/config",
      "dest": "/api/stripe?action=config"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/locations(.html)?",
      "headers": { "Location": "/tiers" },
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-create-rooms",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/waitlist/cron-expire-offers",
      "schedule": "30 0 * * *"
    }
  ]
}
